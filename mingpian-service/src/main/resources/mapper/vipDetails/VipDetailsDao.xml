<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sqx.modules.vipDetails.dao.VipDetailsDao">

    <resultMap type="com.sqx.modules.vipDetails.entity.VipDetails" id="VipMap">
        <result property="id" column="id" jdbcType="VARCHAR"/>
        <result property="vipMonthCount" column="vip_month_count" jdbcType="INTEGER"/>
        <result property="vipName" column="vip_name" jdbcType="INTEGER"/>
        <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
        <result property="updateTime" column="update_time" jdbcType="TIMESTAMP"/>
        <result property="isEnable" column="is_enable" jdbcType="INTEGER"/>
        <result property="sort" column="sort" jdbcType="VARCHAR"/>
    </resultMap>

    <select id="queryByPage" resultMap="VipMap">
        select
            *
        from
            vip_details
        <where>
            <if test="isEnable != null">
                and is_enable=#{isEnable}
            </if>
        </where>
        order by sort
    </select>
</mapper>

