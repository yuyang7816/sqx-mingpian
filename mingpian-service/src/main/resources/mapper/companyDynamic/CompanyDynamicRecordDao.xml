<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sqx.modules.companyDynamic.dao.CompanyDynamicRecordDao">

    <resultMap type="com.sqx.modules.companyDynamic.entity.CompanyDynamicRecord" id="CompanyDynamicRecordMap">
        <result property="id" column="id" jdbcType="VARCHAR"/>
        <result property="companyCardId" column="company_card_id" jdbcType="INTEGER"/>
        <result property="staffCardId" column="staff_card_id" jdbcType="INTEGER"/>
        <result property="title" column="title" jdbcType="VARCHAR"/>
        <result property="content" column="content" jdbcType="VARCHAR"/>
        <result property="dynamicType" column="dynamic_type" jdbcType="INTEGER"/>
        <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
        <result property="updateTime" column="update_time" jdbcType="TIMESTAMP"/>
        <result property="remark" column="remark" jdbcType="VARCHAR"/>
    </resultMap>

    <select id="queryByComCardId" resultType="java.util.LinkedHashMap">
        SELECT
            a.id,
            a.create_time as createTime,
            a.company_card_id as companyCardId,
            a.staff_card_id as staffCardId,
            a.dynamic_type as dynamicType,
            b.real_name as realName,
            b.card_avatar as cardAvatar
        FROM
            `company_dynamic_record` a
                LEFT JOIN business_card b ON a.staff_card_id = b.card_id
        where
            a.company_card_id=#{comCardId}
    </select>

</mapper>

