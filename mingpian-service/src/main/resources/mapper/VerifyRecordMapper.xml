<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sqx.modules.verify.db.mapper.VerifyRecordMapper">

    <select id="pageInfo" resultType="com.sqx.modules.verify.model.vo.VerifyRecordVO">
        SELECT
            vr.*,
            u.user_name,
            u.phone,
            u.avatar
        FROM
            verify_record vr
        LEFT JOIN tb_user u ON vr.user_id = u.user_id
        <where>
            <if test="param.userId != null">
                and vr.user_id = #{param.userId}
            </if>
            <if test="param.name != null and param.name != ''">
                and vr.name like concat('%', #{param.name} ,'%')
            </if>
        </where>
        ORDER BY
            vr.create_time DESC
    </select>
</mapper>
